{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "schema",
    "labels",
    "folder",
    "entry",
    "inputs",
    "outputs",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "apiVersion": {
      "const": 1
    },
    "schema": {
      "type": "integer",
      "minimum": 1
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "folder": {
      "type": "string"
    },
    "entry": {
      "type": "string",
      "pattern": "^(?:[a-z0-9-]+/)+$"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localDraft": {
      "type": "string"
    },
    "fileExtension": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,7}$"
    }
  }
}
